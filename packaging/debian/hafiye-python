#!/bin/sh
set -eu

# Resolve the packaged backend without requiring a shell profile. A user
# dependency venv takes precedence over the package's optional build venv;
# the system interpreter remains available for stdlib-only commands such as
# --version and the dependency doctor.
PACKAGE_ROOT="${HAFIYE_PACKAGE_ROOT:-/usr/lib/hafiye}"
export HAFIYE_PACKAGE_ROOT="$PACKAGE_ROOT"
BACKEND_ROOT="$PACKAGE_ROOT/backend"
USER_VENV="${HAFIYE_PYTHON_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/hafiye/python-venv}"

if [ -n "${HAFIYE_PACKAGE_PYTHON:-}" ]; then
    PYTHON="$HAFIYE_PACKAGE_PYTHON"
elif [ -x "$USER_VENV/bin/python" ]; then
    PYTHON="$USER_VENV/bin/python"
elif [ -x "$BACKEND_ROOT/.venv/bin/python" ]; then
    PYTHON="$BACKEND_ROOT/.venv/bin/python"
else
    PYTHON="$(command -v python3 2>/dev/null || true)"
fi

if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
    echo "Hafiye requires python3 3.11–3.13; run hafiye package doctor." >&2
    exit 127
fi

if [ -n "${PYTHONPATH:-}" ]; then
    PYTHONPATH="$BACKEND_ROOT:$PYTHONPATH"
else
    PYTHONPATH="$BACKEND_ROOT"
fi
export PYTHONPATH
export PYTHONUTF8="${PYTHONUTF8:-1}"

exec "$PYTHON" "$@"
